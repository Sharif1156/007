# DESCO Energy Agent — environment variables
PORT=3000

# Demo mode: true = simulated data (works immediately, no DESCO account needed)
# false  = connect to the real DESCO Prepaid portal APIs
DEMO_MODE=true

# ---- Real DESCO portal endpoints (discover via browser DevTools Network tab) ----
# Example values — REPLACE with the actual endpoints you find on prepaid.desco.org.bd
DESCO_BASE_URL=https://prepaid.desco.org.bd
REAL_LOGIN_ENDPOINT=/api/customer-login
REAL_BALANCE_ENDPOINT=/api/meter-balance
REAL_CONSUMPTION_ENDPOINT=/api/consumption
REAL_RECHARGE_ENDPOINT=/api/recharge
REAL_HISTORY_ENDPOINT=/api/recharge-history
